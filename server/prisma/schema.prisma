// CivicOS Database Schema
// Every table indexed. Every foreign key correct. Production ready.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- CITIES ---
// The atomic unit of CivicOS. Every city in America gets one row.
model City {
  id            String   @id @default(uuid())
  name          String
  state         String   @db.VarChar(2)
  population    Int?
  // Report card fields — updated weekly by cron
  grade         String?  @db.VarChar(2) // A+ through F
  responseRate  Float?   @map("response_rate") // 0.0 to 1.0
  avgResolveDays Float?  @map("avg_resolve_days")
  lastGradedAt  DateTime? @map("last_graded_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  budgets       Budget[]
  issues        Issue[]
  officials     CityOfficial[]

  @@unique([name, state])
  @@index([state])
  @@index([grade])
  @@map("cities")
}

// --- BUDGETS ---
// One row per city per fiscal year. Stores both raw and parsed data.
model Budget {
  id             String   @id @default(uuid())
  cityId         String   @map("city_id")
  fiscalYear     Int      @map("fiscal_year")
  totalRevenue   BigInt   @map("total_revenue") // cents, not dollars — no floating point money
  totalExpenses  BigInt   @map("total_expenses")
  // Breakdown stored as JSON: [{department, amount, category}]
  departments    Json
  // Source tracking for transparency
  sourceUrl      String?  @map("source_url")
  sourceType     String?  @map("source_type") // "pdf", "csv", "api", "manual"
  ingestedAt     DateTime @default(now()) @map("ingested_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  city           City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, fiscalYear])
  @@index([cityId])
  @@index([fiscalYear])
  @@map("budgets")
}

// --- ISSUES ---
// Potholes, broken pipes, dead streetlights. The core civic complaint.
model Issue {
  id            String       @id @default(uuid())
  cityId        String       @map("city_id")
  userId        String?      @map("user_id") // null = anonymous
  title         String       @db.VarChar(200)
  description   String
  category      String       // "roads", "water", "lighting", "parks", "sanitation", "other"
  status        IssueStatus  @default(REPORTED)
  // Location
  latitude      Float
  longitude     Float
  address       String?
  // Media — stored in Cloudflare R2
  photoUrls     String[]     @map("photo_urls")
  // Pressure metrics
  signatureCount Int         @default(0) @map("signature_count")
  // Accountability clock — starts at creation
  reportedAt    DateTime     @default(now()) @map("reported_at")
  acknowledgedAt DateTime?   @map("acknowledged_at")
  resolvedAt    DateTime?    @map("resolved_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  city          City         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  signatures    IssueSignature[]
  updates       IssueUpdate[]
  notifications Notification[]

  @@index([cityId])
  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([cityId, status])
  @@index([signatureCount(sort: Desc)])
  @@index([reportedAt])
  @@map("issues")
}

enum IssueStatus {
  REPORTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  IGNORED // 14 days, no response. The word is deliberate.
}

// --- ISSUE SIGNATURES ---
// Pile-on pressure. Each signature is a citizen saying "fix this."
model IssueSignature {
  id        String   @id @default(uuid())
  issueId   String   @map("issue_id")
  userId    String?  @map("user_id") // null = anonymous
  comment   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId]) // one signature per user per issue
  @@index([issueId])
  @@index([userId])
  @@map("issue_signatures")
}

// --- ISSUE UPDATES ---
// Public status timeline. Every change logged. No hiding.
model IssueUpdate {
  id          String      @id @default(uuid())
  issueId     String      @map("issue_id")
  authorId    String?     @map("author_id") // system updates have null author
  authorType  AuthorType  @default(SYSTEM)
  oldStatus   IssueStatus? @map("old_status")
  newStatus   IssueStatus? @map("new_status")
  comment     String?
  photoUrls   String[]    @map("photo_urls")
  createdAt   DateTime    @default(now()) @map("created_at")

  issue       Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([createdAt])
  @@map("issue_updates")
}

enum AuthorType {
  SYSTEM
  CITIZEN
  OFFICIAL
}

// --- USERS ---
// Synced from Clerk. We store what we need for queries and notifications.
model User {
  id            String   @id // Clerk user ID
  email         String?  @unique
  displayName   String?  @map("display_name")
  phone         String?
  // Notification preferences
  emailNotify   Boolean  @default(true) @map("email_notify")
  smsNotify     Boolean  @default(false) @map("sms_notify")
  weeklyDigest  Boolean  @default(true) @map("weekly_digest")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// --- CITY OFFICIALS ---
// Named. Public. Accountable.
model CityOfficial {
  id          String   @id @default(uuid())
  cityId      String   @map("city_id")
  name        String
  title       String   // "Mayor", "City Manager", "Public Works Director"
  department  String?
  email       String?
  phone       String?
  photoUrl    String?  @map("photo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@index([department])
  @@map("city_officials")
}

// --- NOTIFICATIONS ---
// Every alert tracked. SMS, email, escalation — all logged.
model Notification {
  id          String           @id @default(uuid())
  userId      String?          @map("user_id")
  issueId     String?          @map("issue_id")
  type        NotificationType
  channel     NotificationChannel
  subject     String?
  body        String
  sentAt      DateTime?        @map("sent_at")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  issue       Issue?           @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([issueId])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  ISSUE_UPDATE
  SIGNATURE_MILESTONE // 50, 100, 500
  ESCALATION
  WEEKLY_DIGEST
  STATUS_CHANGE
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}
